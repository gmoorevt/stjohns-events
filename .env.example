# Copy this to .env and fill in real values. .env is gitignored.

# Eventbrite
EVENTBRITE_API_KEY=
EVENTBRITE_CLIENT_SECRET=
EVENTBRITE_PRIVATE_TOKEN=
EVENTBRITE_PUBLIC_TOKEN=
EVENTBRITE_OAUTH_TOKEN=
EVENTBRITE_ORG_ID=
EVENTBRITE_EVENT_ID=1989097915410

# Auth
ADMIN_EMAIL=geody.moore@gmail.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=30
# Set to "true" in production (HTTPS only); leave unset/false for local http
COOKIE_SECURE=false

# Gmail SMTP — App Password (requires 2FA on the Google account)
# https://myaccount.google.com/apppasswords
GMAIL_USER=geody.moore@gmail.com
GMAIL_APP_PASSWORD=

# App / CORS
APP_BASE_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# Database (default works for local dev)
DATABASE_URL=sqlite:///./summerfest.db
